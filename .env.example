# Copy to .env.local and fill in. Never commit .env.local.
#
# Only needed for a bare `npm run dev`. The packaged desktop app generates and stores
# these itself, in secrets.json inside its data folder — Electron passes them to the
# server at launch.

# Signs the judge session cookie. Generate: openssl rand -base64 48
JUDGE_SESSION_SECRET=

# Mixed into the access-code hash. Generate: openssl rand -base64 32
# Changing this invalidates every existing judge code.
JUDGE_CODE_PEPPER=
