# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the judge session cookie. Generate: openssl rand -base64 48
JUDGE_SESSION_SECRET=

# Mixed into the access-code hash. Generate: openssl rand -base64 32
# Changing this invalidates every existing judge code.
JUDGE_CODE_PEPPER=
