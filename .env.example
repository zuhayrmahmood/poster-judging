# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Postgres, from Project Settings -> Database -> Connection string.
#
# Use the *transaction pooler* URI (port 6543) for the app: each serverless instance
# opens its own pool, and the direct connection limit will not survive a hall of judges.
# `npm run migrate` is the one exception — point it at the direct connection (5432).
DATABASE_URL=

# Supabase Auth, from Project Settings -> API. Used only to sign organisers in;
# all data access goes through DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the judge session cookie. Generate: openssl rand -base64 48
JUDGE_SESSION_SECRET=

# Mixed into the access-code hash. Generate: openssl rand -base64 32
# Changing this invalidates every existing judge code.
JUDGE_CODE_PEPPER=
